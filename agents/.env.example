MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=paperdesk

# Optional for Atlas when the system DNS resolver refuses SRV lookups.
# MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8

# Lightning's OpenAI-compatible Chat Completions endpoint (same as light.py).
AGENT_MODEL=openai:lightning-ai/deepseek-v4.1-flash
AGENT_MODEL_BASE_URL=https://lightning.ai/api/v1/
AGENT_MODEL_API_KEY=

# For Groq instead, clear the two custom endpoint settings above and set:
# AGENT_MODEL=groq:qwen/qwen3.8-27b
# GROQ_API_KEY=

# Limits apply to each model call; Express waits at most 60 seconds per analysis.
AGENT_MODEL_TIMEOUT_SECONDS=20
AGENT_MODEL_MAX_TOKENS=2048

# Required for service startup: fetch ticket-analysis-system's production label.
# Use a reachable address for agents in Docker/on the Pi.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3001
LANGFUSE_TRACING_ENVIRONMENT=development
# The HTTP service requires true and both keys to load its production prompt.
LANGFUSE_TRACING_ENABLED=true

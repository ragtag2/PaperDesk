MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=paperdesk

# Optional for Atlas when the system DNS resolver refuses SRV lookups.
# MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8

AGENT_MODEL=groq:qwen/qwen3.8-27b
GROQ_API_KEY=

# Limits apply to each model call; Express waits at most 60 seconds per analysis.
AGENT_MODEL_TIMEOUT_SECONDS=20
AGENT_MODEL_MAX_TOKENS=2048

# Optional Langfuse tracing. Use a reachable address for agents in Docker/on the Pi.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3001
LANGFUSE_TRACING_ENVIRONMENT=development
# Set false to disable tracing while keeping local JSON reports.
LANGFUSE_TRACING_ENABLED=true

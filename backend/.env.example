MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER/paperdesk
MONGODB_DB_NAME=paperdesk
# Enable background incident coordination when the Python service is running:
# AGENT_BASE_URL=http://127.0.0.1:8000
# Optional if your Windows DNS resolver refuses Atlas SRV lookups:
# MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
FRONTEND_ORIGIN=http://localhost:5173
PORT=3000
# Set to 1 when running behind a trusted HTTPS ingress or reverse proxy.
TRUST_PROXY=0
